# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored - NEVER commit real credentials.
# ---------------------------------------------------------------------------

# PostgreSQL connection (libpq variable names)
PGHOST=localhost
PGPORT=5432
PGDATABASE=erp
PGUSER=erp
PGPASSWORD=change_me

# Optional: a single DSN overrides the individual variables above.
# DATABASE_URL=postgresql://erp:change_me@localhost:5432/erp

# ---------------------------------------------------------------------------
# Dataset configuration (all optional; defaults shown)
# ---------------------------------------------------------------------------
ERP_SEED=20240101

# Organizational scale
ERP_N_BRANCHES=5
ERP_N_WAREHOUSES=3
ERP_N_EMPLOYEES=120

# Catalog and partners
ERP_N_SUPPLIERS=20
ERP_N_PRODUCTS=500
ERP_N_CUSTOMERS=300

# Transactions
ERP_N_SALES_ORDERS=10000
ERP_MAX_ITEMS_PER_ORDER=10
ERP_N_PURCHASE_ORDERS=500
ERP_N_STOCK_TRANSFERS=200

# History window (inclusive)
ERP_HISTORY_START=2023-01-01
ERP_HISTORY_END=2023-12-31

# Financials and behaviour
ERP_TAX_RATE=0.08
ERP_CURRENCY=USD
ERP_CANCEL_RATE=0.04
ERP_RETURN_RATE=0.06
ERP_DELAYED_SHIPMENT_RATE=0.08
ERP_PARTIAL_PO_RATE=0.15
ERP_DELAYED_PO_RATE=0.12
