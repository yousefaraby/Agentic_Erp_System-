        </mxCell>
        <mxCell id="trigger" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;TRIGGERS&lt;/b&gt;&lt;br&gt;• Request workbook arrives&lt;br&gt;• Manager asks for a report (later UI)&lt;br&gt;• Scheduled low-stock scan" vertex="1">
