        <mxCell id="step2" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" target="s4" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1480" y="370" />
              <mxPoint x="320" y="370" />
