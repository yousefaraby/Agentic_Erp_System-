        <mxCell id="step3" edge="1" parent="1" source="s4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" target="s5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step4" edge="1" parent="1" source="s5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" target="s6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="team1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;PERSON 1 · Orchestrator&lt;/b&gt;&lt;br&gt;Own task contracts, run lifecycle, routing, retries and aggregation. Integrates agent handoffs." vertex="1">
          <mxGeometry height="185" width="500" x="60" y="760" as="geometry" />
        </mxCell>
        <mxCell id="team2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;PERSON 2 · Sales agent&lt;/b&gt;&lt;br&gt;Own sales intent tasks, scoped sales/product queries, order draft recommendations and result quality." vertex="1">
          <mxGeometry height="185" width="500" x="650" y="760" as="geometry" />
        </mxCell>
        <mxCell id="team3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2e3;strokeColor=#2e9e5b;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;PERSON 3 · Inventory agent&lt;/b&gt;&lt;br&gt;Own stock/warehouse tasks, availability and reservation analysis; validate multi-branch/warehouse behavior." vertex="1">
          <mxGeometry height="185" width="500" x="1240" y="760" as="geometry" />
        </mxCell>
        <mxCell id="team4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;PERSON 4 · Procurement agent&lt;/b&gt;&lt;br&gt;Own supplier/open-PO analysis and draft replenishment proposals. No purchase-order write access." vertex="1">
          <mxGeometry height="185" width="500" x="350" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="team5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;PERSON 5 · Returns agent&lt;/b&gt;&lt;br&gt;Own return/refund questions, read-only return/payment queries, status explanations and draft return-review recommendations. No direct refund or database writes." vertex="1">
          <mxGeometry height="185" width="500" x="950" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="principle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;CONTROL RULE&lt;/b&gt;&lt;br&gt;Agents may read and recommend. A deterministic workflow can write only after it validates the manager’s returned approval file. No direct agent database writes." vertex="1">
          <mxGeometry height="115" width="1140" x="330" y="1300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
