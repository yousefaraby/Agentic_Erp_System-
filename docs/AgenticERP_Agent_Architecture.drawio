        <mxCell id="draft" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;Draft review workbook&lt;/b&gt;&lt;br&gt;Orchestrator combines results and writes request ID + revision, source facts, proposed actions and validation summary." vertex="1">
