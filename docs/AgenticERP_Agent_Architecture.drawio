  <diagram id="contracts" name="2 · Agent communication and functions">
    <mxGraphModel dx="1800" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Agent communication · contracts and functions" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1700" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Agents do not chat freely: orchestrator routes typed tasks and stores a traceable result for each handoff" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=14;fontColor=#44546A;" vertex="1" parent="1">
          <mxGeometry x="50" y="78" width="1700" height="38" as="geometry" />
        </mxCell>
        <mxCell id="envelope" value="&lt;b&gt;TASK ENVELOPE · Orchestrator → agent&lt;/b&gt;&lt;br&gt;run_id, task_id, parent_task_id&lt;br&gt;task_type, branch_id, warehouse_id&lt;br&gt;input_refs, time_window, constraints&lt;br&gt;allowed_tools, deadline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="agentwork" value="&lt;b&gt;AGENT EXECUTION&lt;/b&gt;&lt;br&gt;1. Read only its assigned task&lt;br&gt;2. Call allow-listed read tools&lt;br&gt;3. Return evidence-linked facts&lt;br&gt;4. Make a recommendation or draft&lt;br&gt;5. Return status or a clear error&lt;br&gt;&lt;br&gt;No agent-to-agent direct calls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2e3;strokeColor=#2e9e5b;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="160" width="500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;RESULT ENVELOPE · agent → Orchestrator&lt;/b&gt;&lt;br&gt;run_id, task_id, agent_name&lt;br&gt;status: ok / needs_input / no_data / error&lt;br&gt;facts + source record references&lt;br&gt;recommendation + assumptions&lt;br&gt;validation warnings / error details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="160" width="500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="envelope" target="agentwork">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agentwork" target="result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="orchestration_functions" value="&lt;b&gt;Orchestrator functions&lt;/b&gt;&lt;br&gt;ingest_trigger()&lt;br&gt;validate_request()&lt;br&gt;classify_intent()&lt;br&gt;plan_tasks()&lt;br&gt;dispatch_task()&lt;br&gt;collect_results()&lt;br&gt;merge_results()&lt;br&gt;handle_timeout_or_error()&lt;br&gt;create_review_file()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="500" height="365" as="geometry" />
        </mxCell>
        <mxCell id="specialist_functions" value="&lt;b&gt;Specialist agent functions&lt;/b&gt;&lt;br&gt;Sales: get_sales_summary(), draft_order()&lt;br&gt;Stock: get_availability(), evaluate_stock_risk()&lt;br&gt;Procurement: compare_suppliers(), draft_purchase_request()&lt;br&gt;Returns: summarize_return(), check_refund_status(), draft_return_review()&lt;br&gt;&lt;br&gt;Each function consumes a typed task and returns a typed result. Exact calculations stay in deterministic services." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="500" width="500" height="365" as="geometry" />
        </mxCell>
        <mxCell id="tool_functions" value="&lt;b&gt;Database tool / service functions&lt;/b&gt;&lt;br&gt;Read-only tools:&lt;br&gt;get_branch_warehouse_map()&lt;br&gt;get_inventory_snapshot()&lt;br&gt;get_sales_summary()&lt;br&gt;get_open_purchase_orders()&lt;br&gt;&lt;br&gt;Approved write commands:&lt;br&gt;commit_approved_order()&lt;br&gt;commit_approved_purchase_request()&lt;br&gt;cancel_or_release_reservation()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="500" width="500" height="365" as="geometry" />
        </mxCell>
        <mxCell id="read_boundary" value="&lt;b&gt;READ BOUNDARY&lt;/b&gt;&lt;br&gt;Agent → read-only tool gateway → PostgreSQL&lt;br&gt;Use SQLAlchemy, parameterized queries and explicit branch/warehouse scope. Agents never receive a database connection or arbitrary SQL access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="1010" width="650" height="190" as="geometry" />
        </mxCell>
        <mxCell id="write_boundary" value="&lt;b&gt;WRITE BOUNDARY&lt;/b&gt;&lt;br&gt;Manager returns approval workbook → importer validates hash/revision/decision → deterministic transaction service writes to PostgreSQL → audit row.&lt;br&gt;&lt;br&gt;Rejected, cancelled or needs-changes files make no business-data write." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="1010" width="700" height="190" as="geometry" />
        </mxCell>
        <mxCell id="read_path" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="specialist_functions" target="read_boundary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="write_path" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tool_functions" target="write_boundary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="noauth" value="&lt;b&gt;MVP choice&lt;/b&gt;&lt;br&gt;No login, user accounts or access-control layer. Optional typed manager name in the approval workbook is descriptive only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="510" y="1300" width="700" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="build" name="3 · Build sequence and five-person split">
    <mxGraphModel dx="1285" dy="553" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1F3864;" value="Build the agents in a safe order · divide work across five people" vertex="1">
          <mxGeometry height="48" width="1700" x="50" y="25" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=14;fontColor=#44546A;" value="Start with contracts and one read-only vertical slice; add more agents after the first workflow is reliable" vertex="1">
          <mxGeometry height="38" width="1700" x="50" y="78" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;1 · Define scenarios + contracts&lt;/b&gt;&lt;br&gt;Choose first requests: order/availability, low-stock review, purchase suggestion. Freeze TaskEnvelope, AgentResult and status names." vertex="1">
          <mxGeometry height="190" width="520" x="60" y="160" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2e3;strokeColor=#2e9e5b;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;2 · Build database read tools&lt;/b&gt;&lt;br&gt;Implement allow-listed SQLAlchemy queries for branch/warehouse map, sales, inventory, reservations and open purchase orders." vertex="1">
          <mxGeometry height="190" width="520" x="640" y="160" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;3 · Build orchestrator skeleton&lt;/b&gt;&lt;br&gt;Implement triggers, run/task records, routing, result collection, timeouts, errors and review-file generation. Start synchronous; no queue yet." vertex="1">
          <mxGeometry height="190" width="520" x="1220" y="160" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;4 · Add read-only specialists&lt;/b&gt;&lt;br&gt;Build Sales, Inventory, Procurement and Returns agents using only shared tools; return structured facts and recommendations." vertex="1">
          <mxGeometry height="190" width="520" x="60" y="440" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;5 · Add approval-file loop&lt;/b&gt;&lt;br&gt;Generate versioned workbook; import manager status/note; reject modified, stale or duplicate files; write only approved transactions." vertex="1">
          <mxGeometry height="190" width="520" x="640" y="440" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;arcSize=8;" value="&lt;b&gt;6 · Evaluate + expand triggers&lt;/b&gt;&lt;br&gt;Test branch/warehouse cases, missing data, concurrent requests, retries and approvals. Add scheduled runs and parallel tasks after correctness." vertex="1">
          <mxGeometry height="190" width="520" x="1220" y="440" as="geometry" />
        </mxCell>
        <mxCell id="step0" edge="1" parent="1" source="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" target="s2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step1" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" target="s3" value="">
          <mxGeometry relative="1" as="geometry" />
