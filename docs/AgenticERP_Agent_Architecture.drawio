        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1F3864;" value="Agentic ERP · agent runtime pipeline" vertex="1">
          <mxGeometry height="48" width="1700" x="50" y="25" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=14;fontColor=#44546A;" value="What triggers a run · how agents coordinate · where database reads and approved writes happen" vertex="1">
