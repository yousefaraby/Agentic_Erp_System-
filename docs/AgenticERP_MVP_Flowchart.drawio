<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-28T19:45:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="mvp" name="1 · MVP file approval workflow"><mxGraphModel dx="1800" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Agentic ERP · MVP sales and stock workflow" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1700" height="48" as="geometry" /></mxCell><mxCell id="subtitle" value="File based manager approval · no login, user accounts, access control, or active AI agents in this MVP" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=14;fontColor=#44546A;" vertex="1" parent="1"><mxGeometry x="50" y="78" width="1700" height="38" as="geometry" /></mxCell><mxCell id="scope" value="&lt;b&gt;MVP operating rule&lt;/b&gt;&lt;br&gt;Spreadsheets are the manager review and approval interface. PostgreSQL stores validated operational records and the audit trail." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="1700" height="70" as="geometry" /></mxCell><mxCell id="in" value="&lt;b&gt;1 · Request file arrives&lt;/b&gt;&lt;br&gt;Manager or staff places an order request workbook in the intake folder.&lt;br&gt;&lt;br&gt;Required: branch, requested warehouse, customer, products, quantities, request date." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="620" y="230" width="560" height="105" as="geometry" /></mxCell><mxCell id="check" value="&lt;b&gt;2 · Deterministic validation&lt;/b&gt;&lt;br&gt;Check file shape, identifiers, branch/warehouse service mapping, products, quantities, prices and available stock.&lt;br&gt;&lt;br&gt;Invalid requests return with row level errors; no ERP transaction is written." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2e3;strokeColor=#2e9e5b;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="620" y="365" width="560" height="125" as="geometry" /></mxCell><mxCell id="review" value="&lt;b&gt;3 · Prepare review workbook&lt;/b&gt;&lt;br&gt;Create a request ID and revision. Include the exact order values, stock check, totals and validation summary for the manager to review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="620" y="520" width="560" height="100" as="geometry" /></mxCell><mxCell id="manager" value="&lt;b&gt;4 · Manager edits approval fields&lt;/b&gt;&lt;br&gt;Manager sets &lt;b&gt;Approved&lt;/b&gt;, &lt;b&gt;Rejected / Cancelled&lt;/b&gt;, or &lt;b&gt;Needs changes&lt;/b&gt; and may add a note.&lt;br&gt;&lt;br&gt;Business fields stay locked; a requested change becomes a new revision for approval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="620" y="650" width="560" height="145" as="geometry" /></mxCell><mxCell id="import" value="&lt;b&gt;5 · Import returned workbook&lt;/b&gt;&lt;br&gt;Verify request ID, revision and original values. Accept only the decision, note and optional manager name fields. Reject altered, stale or duplicate files for review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="620" y="825" width="560" height="120" as="geometry" /></mxCell><mxCell id="decision" value="Approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="810" y="980" width="180" height="115" as="geometry" /></mxCell><mxCell id="commit" value="&lt;b&gt;Approved · commit once&lt;/b&gt;&lt;br&gt;In one database transaction, create the sales order and lines, reserve stock when available, and record the approval decision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1090" y="1110" width="400" height="120" as="geometry" /></mxCell><mxCell id="decline" value="&lt;b&gt;Rejected / Cancelled / Needs changes&lt;/b&gt;&lt;br&gt;Do not create or change stock or sales records. Return the status and manager note; revised requests receive a new revision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="310" y="1110" width="440" height="120" as="geometry" /></mxCell><mxCell id="audit" value="&lt;b&gt;Every outcome is traceable&lt;/b&gt;&lt;br&gt;Record source and returned-file hashes, request ID/revision, import batch, decision, note, timestamp and resulting ERP record IDs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="1270" width="500" height="100" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in" target="check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="check" target="review"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="review" target="manager"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="manager" target="import"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="import" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_yes" value="Yes · approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2e7d32;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="decision" target="commit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_no" value="No · reject / cancel / changes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="decision" target="decline"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_audit_yes" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="commit" target="audit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_audit_no" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="decline" target="audit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_revision" value="Needs changes · new revision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="decline" target="review"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nobody" value="&lt;b&gt;No authentication or user accounts in MVP&lt;/b&gt;&lt;br&gt;The manager acts by editing the returned approval file. A typed name is optional record text, not a login identity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="990" width="460" height="95" as="geometry" /></mxCell><mxCell id="boundary" value="&lt;b&gt;AI agents are not in Phase 1&lt;/b&gt;&lt;br&gt;Use deterministic validation and import rules first. Future agents may prepare recommendations or review files, but cannot directly write operational records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1300" y="990" width="430" height="95" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="db" name="2 · Database foundation and data flow"><mxGraphModel dx="1800" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Phase 1 · PostgreSQL foundation" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1700" height="48" as="geometry" /></mxCell><mxCell id="subtitle" value="Verified implementation status · corrected source files preserved · generated imports retain provenance" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=14;fontColor=#44546A;" vertex="1" parent="1"><mxGeometry x="50" y="78" width="1700" height="38" as="geometry" /></mxCell><mxCell id="stat1" value="&lt;b&gt;31 source tables&lt;/b&gt;&lt;br&gt;Corrected CSV data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="390" height="90" as="geometry" /></mxCell><mxCell id="stat2" value="&lt;b&gt;6 branches · 3 warehouses&lt;/b&gt;&lt;br&gt;All six departments represented" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2e3;strokeColor=#2e9e5b;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="390" height="90" as="geometry" /></mxCell><mxCell id="stat3" value="&lt;b&gt;45 reconciliation checks&lt;/b&gt;&lt;br&gt;0 failures after import" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="890" y="140" width="390" height="90" as="geometry" /></mxCell><mxCell id="stat4" value="&lt;b&gt;11 automated tests&lt;/b&gt;&lt;br&gt;PostgreSQL 16 · Python 3.12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1310" y="140" width="390" height="90" as="geometry" /></mxCell><mxCell id="src" value="&lt;b&gt;Preserved corrected CSV source&lt;/b&gt;&lt;br&gt;31 tables plus manifest and validation report&lt;br&gt;SHA-256 and row counts checked on every import" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="350" height="145" as="geometry" /></mxCell><mxCell id="loader" value="&lt;b&gt;Repeatable atomic importer&lt;/b&gt;&lt;br&gt;Validate hashes, headers and counts → import in dependency order → reconcile data&lt;br&gt;&lt;br&gt;Same dataset re-run is idempotent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="310" width="390" height="145" as="geometry" /></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL · erp schema&lt;/b&gt;&lt;br&gt;SQLAlchemy mappings + Alembic migrations&lt;br&gt;&lt;br&gt;Docker Compose · PostgreSQL 16&lt;br&gt;Local port 55432" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="990" y="310" width="390" height="145" as="geometry" /></mxCell><mxCell id="prov" value="&lt;b&gt;Provenance schema&lt;/b&gt;&lt;br&gt;Import batches and file hashes&lt;br&gt;Explicitly tagged derived inventory snapshots&lt;br&gt;Approval-file history will be added with the MVP workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="310" width="300" height="145" as="geometry" /></mxCell><mxCell id="db1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src" target="loader"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="db2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loader" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="db3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pg" target="prov"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="org" value="&lt;b&gt;Organization&lt;/b&gt;&lt;br&gt;Branches ↔ warehouses via effective dated service mappings&lt;br&gt;Departments → employees&lt;br&gt;Employees tied to operational branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2e3;strokeColor=#2e9e5b;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="500" height="160" as="geometry" /></mxCell><mxCell id="inv" value="&lt;b&gt;Inventory&lt;/b&gt;&lt;br&gt;Warehouse + product inventory&lt;br&gt;Stock movements are the ledger&lt;br&gt;Reservations reconcile to reserved quantities&lt;br&gt;14 missing snapshot pairs derived from movements and recorded as derived" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="650" y="560" width="500" height="160" as="geometry" /></mxCell><mxCell id="sales" value="&lt;b&gt;Sales&lt;/b&gt;&lt;br&gt;Orders → order lines&lt;br&gt;Payments → refunds and returns&lt;br&gt;Order employee branch must match order branch&lt;br&gt;Totals and links enforced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1240" y="560" width="500" height="160" as="geometry" /></mxCell><mxCell id="supply" value="&lt;b&gt;Supply operations&lt;/b&gt;&lt;br&gt;Purchase orders → lines → receipts&lt;br&gt;Warehouse transfers → movements&lt;br&gt;Request/approval separation is validated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="350" y="810" width="500" height="145" as="geometry" /></mxCell><mxCell id="checks" value="&lt;b&gt;Verified reconciliation&lt;/b&gt;&lt;br&gt;Sales and purchase totals&lt;br&gt;Stock ledger and inventory projections&lt;br&gt;Reservation and return/refund balances&lt;br&gt;Source hashes, identities and foreign keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="950" y="810" width="500" height="145" as="geometry" /></mxCell><mxCell id="rel1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="org" target="inv"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="org" target="sales"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inv" target="supply"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sales" target="checks"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52677D;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="supply" target="checks"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lim" value="&lt;b&gt;Foundation boundary&lt;/b&gt;&lt;br&gt;The database, importer and integrity tests are complete and verified. The API, approval-file round trip, UI and AI agents are not implemented yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330" y="1010" width="1140" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="phases" name="3 · Delivery phases and agent boundary"><mxGraphModel dx="1800" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="What is implemented · what comes next" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1700" height="48" as="geometry" /></mxCell><mxCell id="subtitle" value="MVP priority: a reliable manager approval loop over validated ERP transactions; add AI only after deterministic rules are tested" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=14;fontColor=#44546A;" vertex="1" parent="1"><mxGeometry x="50" y="78" width="1700" height="38" as="geometry" /></mxCell><mxCell id="done" value="&lt;b&gt;DONE · Phase 1 database foundation&lt;/b&gt;&lt;br&gt;PostgreSQL schema and constraints&lt;br&gt;SQLAlchemy mappings and Alembic migrations&lt;br&gt;Docker setup and repeatable CSV importer&lt;br&gt;Provenance, 45 integrity checks and 11 automated tests&lt;br&gt;&lt;br&gt;Verified on PostgreSQL 16 / Python 3.12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="480" height="310" as="geometry" /></mxCell><mxCell id="next" value="&lt;b&gt;NEXT · Phase 2 deterministic file workflow&lt;/b&gt;&lt;br&gt;1. Define request and approval workbook templates&lt;br&gt;2. Generate request IDs, revisions and review files&lt;br&gt;3. Import only valid manager decision / note fields&lt;br&gt;4. On approval, commit order + reservation atomically&lt;br&gt;5. On rejection/cancel/change request, make no stock write&lt;br&gt;6. Keep file hashes and decision history&lt;br&gt;&lt;br&gt;No authentication or user table required." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="660" y="190" width="480" height="390" as="geometry" /></mxCell><mxCell id="later" value="&lt;b&gt;LATER · Agent assistance&lt;/b&gt;&lt;br&gt;Agents can read validated ERP data, summarize stock/sales and prepare draft request or review files.&lt;br&gt;&lt;br&gt;Agents do not make manager decisions or directly write operational records. The deterministic importer remains the write boundary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1250" y="190" width="480" height="310" as="geometry" /></mxCell><mxCell id="p1p2" value="Next implementation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="done" target="next"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2p3" value="After workflow is reliable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673a6;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="next" target="later"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="orgcoverage" value="&lt;b&gt;Dataset coverage supported&lt;/b&gt;&lt;br&gt;6 branches · 3 warehouses · 6 departments · 120 employees&lt;br&gt;Each branch/warehouse service relationship and sales location is represented in the corrected source set." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2e3;strokeColor=#2e9e5b;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="690" width="760" height="160" as="geometry" /></mxCell><mxCell id="audit" value="&lt;b&gt;Approval audit record should capture&lt;/b&gt;&lt;br&gt;Request ID + revision · original and returned file hashes · decision · manager note · import timestamp · resulting sales order / reservation IDs.&lt;br&gt;&lt;br&gt;Optional typed manager name is descriptive text only; no login is created." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="690" width="770" height="160" as="geometry" /></mxCell><mxCell id="notyet" value="&lt;b&gt;Not yet tested / implemented&lt;/b&gt;&lt;br&gt;Application API and workbook templates · approval importer · transaction concurrency under multiple workers · production backup/restore schedule · AI agents.&lt;br&gt;Phase 1 verification proves the database foundation only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330" y="960" width="1140" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>